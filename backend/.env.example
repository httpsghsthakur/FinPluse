# ==============================================================================
# FinPulse AI — Backend Environment Configuration Example
# ==============================================================================

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=your_secret_key_min_32_characters_here

# Database (Supabase PostgreSQL / SQLite)
DATABASE_URL=sqlite+aiosqlite:///./finpilot.db
DATABASE_URL_SYNC=sqlite:///./finpilot.db

# Supabase Auth
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS - Frontend URLs
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://finpaluse.onrender.com

# LLM Providers
LLM_PROVIDER=custom_engine
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Auth Mode (none | api_key | jwt | supabase)
AUTH_MODE=none
API_KEY=your_api_key_here

# Data Seeding
SEED_DEMO_DATA=true
DEMO_USER_COUNT=20
DEMO_TRANSACTION_COUNT=1000

# Privacy
DEFAULT_DATA_CONSENT_PERSONALIZATION=true
DEFAULT_DATA_CONSENT_GLOBAL_TRAINING=false

# Market Data Provider
UPSTOX_ANALYTICS_TOKEN=your_upstox_analytics_token_here

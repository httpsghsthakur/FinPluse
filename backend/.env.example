

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=your_secret_key

# Database (Supabase PostgreSQL IPv4 Pooler)
DATABASE_URL=sqlite+aiosqlite:///./finpilot.db
DATABASE_URL_SYNC=sqlite+aiosqlite:///./finpilot.db

# Supabase Auth
SUPABASE_URL=https://example.com
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Redis
REDIS_URL=sqlite+aiosqlite:///./finpilot.db

# CORS - Frontend URL
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://finpaluse.onrender.com

# LLM Provider
LLM_PROVIDER=custom_engine
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# MLflow
MLFLOW_TRACKING_URI=your_mlflow_tracking_uri

# Auth (simple API key for dev, JWT for production)
AUTH_MODE=none
API_KEY=your_api_key

# Data
SEED_DEMO_DATA=true
DEMO_USER_COUNT=20
DEMO_TRANSACTION_COUNT=1000

# Privacy
DEFAULT_DATA_CONSENT_PERSONALIZATION=true
DEFAULT_DATA_CONSENT_GLOBAL_TRAINING=false

# Market Data Provider
UPSTOX_ANALYTICS_TOKEN=your_upstox_analytics_token

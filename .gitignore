# ==============================================================================
# FinPaluse — Git Ignore Configuration
# ==============================================================================

# ── Operating System Files ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ── Node.js & Frontend ────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo
.eslintcache
.vite/

# ── Python & Backend ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
# .eggs/
# .installed.cfg
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual Environments ──────────────────────────────────────────────────────
.env
.venv
venv/
ENV/
env/
env.bak/
venv.bak/

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# ── Environment & Secrets (NEVER COMMIT CREDENTIALS) ──────────────────────────
.env
.env.*
!.env.example
!.env.test
*.pem
*.key
*.cert

# ── Databases & Persistence ───────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── Large Generated ML Datasets & Scratch Files ───────────────────────────────
backend/data/raw/*.csv
backend/data/processed/*.parquet
!backend/data/**/.gitkeep
backend/scratch/
scratch/
fix*
patch*
check_*.py
print_*.py
test_*.py
!backend/tests/**

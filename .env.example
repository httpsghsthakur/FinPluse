# ==============================================================================
# Finpluse — Environment Configuration (.env)
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your_secret_key

# ── Supabase Database (PostgreSQL IPv4 Pooler) ───────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./finpilot.db
DATABASE_URL_SYNC=sqlite+aiosqlite:///./finpilot.db

# ── Supabase Auth ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://example.com
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret


# ── Frontend Public Variables ────────────────────────────────────────────────
VITE_API_BASE_URL=https://finpaluse.onrender.com/api/v1
VITE_SUPABASE_URL=https://example.com
VITE_SUPABASE_ANON_KEY=your_vite_supabase_anon_key


